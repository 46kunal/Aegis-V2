ENVIRONMENT=development
PROJECT_NAME="Aegis V2"
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg2://aegis:change-me@postgres:5432/aegis
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-super-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REPORT_OUTPUT_DIR=/app/generated-reports
PUBLIC_BASE_URL=http://localhost
# Accepts comma-separated values (shell-safe):
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
# Or JSON array:
# CORS_ORIGINS='["http://localhost:5173","http://localhost:3000"]'
NMAP_BINARY=nmap
SCAN_TIMEOUT_FAST_SECONDS=180
SCAN_TIMEOUT_SMART_FAST_SECONDS=300
SCAN_TIMEOUT_MEDIUM_SECONDS=600
SCAN_TIMEOUT_FULL_SECONDS=3600
SCAN_TIMEOUT_SUPER_FULL_SECONDS=7200
LOG_LEVEL=INFO
# NVD API key — get a free one at https://nvd.nist.gov/developers/request-an-api-key
# Without key: 5 req/30s (6.5s sleep). With key: 50 req/30s (0.7s sleep).
# NVD_API_KEY=
